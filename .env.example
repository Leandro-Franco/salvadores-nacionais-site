# Copy to .env.local for local development. Never commit real values.
# Secrets go to the hosting secret manager, one set per environment (spec §17.2).

# --- Server (public-safe values) ---
APP_ENV=local                 # local | staging | production
APP_BASE_URL=http://localhost:3000
SALES_ENABLED=false           # authoritative switch for new kit sales
PAYMENTS_MODE=mock            # mock | sandbox | live
DATA_STORE=memory     # memory (local only) | postgres
DEMO_KITS_SOLD=87             # Phase 1 only: illustrative goal-plan counter
CHECKOUT_TTL_MINUTES=30       # stock hold per checkout; 30 is a demo value

# --- Secrets (empty here on purpose) ---
DATABASE_URL=                 # runtime connection, least privilege
DATABASE_MIGRATION_URL=       # CI/ops only, never exposed to the runtime
IDENTITY_HMAC_KEY=            # 32+ random chars; required outside local
RATE_LIMIT_HMAC_KEY=          # 32+ random chars, different from the one above
MERCADOPAGO_ACCESS_TOKEN=     # required unless PAYMENTS_MODE=mock. Orders API: sandbox uses a TEST USER's production token
MERCADOPAGO_WEBHOOK_SECRET=   # "assinatura secreta" of the Order webhook in the Mercado Pago panel
MERCADOPAGO_USER_ID=          # seller user id; remote orders of any other account go to review
MERCADOPAGO_APPLICATION_ID=   # optional extra check against integration_data.application_id
RECAPTCHA_SECRET_KEY=         # Google reCAPTCHA v2 secret; enables the bot check on checkout
CRON_SECRET=                  # 32+ random chars; Vercel Cron sends it to /api/cron/reconcile

# --- Public (exposed to the browser) ---
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=   # reCAPTCHA v2 site key (public); set together with the secret
NEXT_PUBLIC_MAP_TILE_URL_TEMPLATE=https://tile.openstreetmap.org/{z}/{x}/{y}.png
